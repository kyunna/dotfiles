{{- $data := joinPath .chezmoi.sourceDir ".ssh_data.yaml.age" | include | decrypt | fromYaml -}}
{{- $isMint := eq .chezmoi.hostname "pppp-mint" -}}

Host github.com
    PubkeyAuthentication yes
    IdentityFile {{ if $isMint }}{{ $data.mint_github_identity_file }}{{ else }}{{ $data.github_identity_file }}{{ end }}
{{- range $data.ssh_hosts }}
{{- if or (not $isMint) (hasKey . "mint_identity_file") }}

Host {{ .alias }}
    {{- if hasKey . "hostname" }}
    HostName {{ .hostname }}
    {{- end }}
    {{- if hasKey . "user" }}
    User {{ .user }}
    {{- end }}
    PubkeyAuthentication yes
    IdentityFile {{ if $isMint }}{{ .mint_identity_file }}{{ else }}{{ .identity_file }}{{ end }}
{{- end }}
{{- end }}

Host *
    PubkeyAuthentication no
    IdentitiesOnly yes
